---
import { control, visual, honesty } from '../content/landing.ts';
import FeatureList from './FeatureList.astro';
import StatusChip from './StatusChip.astro';
---
<section id={control.id} class="section control-section">
  <div class="two-columns">
    <div class="section-copy"><h2>{visual.controlTitle[0]}<br />{visual.controlTitle[1]}</h2><StatusChip status="live" /><p class="small muted">{honesty.insuranceShort}<br />{honesty.gap}</p></div>
    <dl class="panel permission-table">{visual.permissions.map((p) => <div><dt>{p.label}</dt><dd>{p.value}</dd></div>)}</dl>
  </div>
  <details class="disclosure"><summary>{visual.controlDetails}</summary><FeatureList group="control" /><p class="small muted">{control.ltvNote}</p><p class="small muted">{control.honesty}</p><a class="text-link" href={control.link.href}>{control.link.label}<span aria-hidden="true"> ↗</span></a></details>
</section>
