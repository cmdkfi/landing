---
import { featuresOf, type Group } from '../content/landing.ts';
import StatusChip from './StatusChip.astro';
interface Props { group: Group }
const items = featuresOf(Astro.props.group);
---
<ul class="features">{items.map((f) => <li data-feature={f.id}><span>{f.text}</span><StatusChip status={f.status} /></li>)}</ul>
