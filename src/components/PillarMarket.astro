---
import { market, visual } from '../content/landing.ts';
import FeatureList from './FeatureList.astro';
import StatusChip from './StatusChip.astro';
import PriceDiagram from './PriceDiagram.astro';
---
<article id={market.id} class="panel response-card">
  <div class="card-heading"><h3>{visual.marketTitle}</h3><StatusChip status="live" /></div>
  <p class="muted">{visual.marketSub}</p>
  <PriceDiagram />
  <details class="card-details">
    <summary>{visual.marketDetails}</summary><FeatureList group="market" />
    <p class="small muted">{market.honesty}</p>
    <a class="text-link" href={market.link.href}>{market.link.label}<span aria-hidden="true"> ↗</span></a>
  </details>
</article>
