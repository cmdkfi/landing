---
import { links, cta, testnetLine, walletBrowserCaption, hero } from '../content/landing.ts';
interface Props { sandbox?: boolean }
const { sandbox = false } = Astro.props;
---
<div class="testnet-actions">
  <div class="action-buttons">
    <a href={links.testnet} class="btn btn-primary">{cta.openTestnet}<span aria-hidden="true">↗</span></a>
    {sandbox && <a href={links.sandbox} class="sandbox-link">{cta.sandbox}<span aria-hidden="true">↗</span></a>}
  </div>
  <div class="action-notes">
    {sandbox && <p>{hero.sandboxCaption}</p>}
    <p>{testnetLine}</p>
    <p class="wallet-browser-caption">{walletBrowserCaption}</p>
  </div>
</div>
