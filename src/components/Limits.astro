---
import { limits, visual } from '../content/landing.ts';
---
<section id={limits.id} class="section">
  <h2>{visual.limitsTitle}</h2>
  <ul class="risk-notes">{limits.honesty.map((line) => <li>{line}</li>)}</ul>
  <h3 class="faq-heading">{limits.faqHeading}</h3>
  <div class="faq-list">{limits.faq.map((item) => <details><summary>{item.q}</summary><p class="muted">{item.a}</p></details>)}</div>
</section>
