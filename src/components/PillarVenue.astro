---
import { venue, visual } from '../content/landing.ts';
import FeatureList from './FeatureList.astro';
import StatusChip from './StatusChip.astro';
---
<article id={venue.id} class="panel response-card">
  <div class="card-heading"><h3>{visual.venueTitle}</h3><StatusChip status="live" /></div>
  <p class="muted">{visual.venueSub}</p>
  <div class="migration-diagram"><div>{visual.venueNodes[0]}</div><span aria-hidden="true">→</span><div>{visual.venueNodes[1]}</div></div>
  <p class="small muted">{visual.venueNote}</p>
  <details class="card-details"><summary>{visual.venueDetails}</summary><FeatureList group="venue-risk" /><p class="small muted">{venue.limit}</p></details>
</article>
