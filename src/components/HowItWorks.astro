---
import { how } from '../content/landing.ts';
import TestnetActions from './TestnetActions.astro';
---
<section id={how.id} class="section">
  <h2>{how.h2}</h2>
  <ol class="mt-4 space-y-4 list-decimal pl-6">
    {how.steps.map((s) => (
      <li>
        <h3 class="inline">{s.title}</h3> <span>{s.text}</span>
      </li>
    ))}
  </ol>
  <p class="mt-6 text-sm text-fg-muted">{how.caption}</p>
  <div class="mt-4"><TestnetActions /></div>
</section>
