---
import { how, visual } from '../content/landing.ts';
---
<section id={how.id} class="section">
  <h2>{visual.howTitle}</h2>
  <ol class="three-columns how-steps">{visual.steps.map((s, i) => <li class="panel"><div class="step-heading"><span class="step-index">{String(i + 1).padStart(2, '0')}</span><h3>{s.title}</h3></div><p class="muted">{s.text}</p></li>)}</ol>
  <p class="section-note">{how.caption}</p>
</section>
