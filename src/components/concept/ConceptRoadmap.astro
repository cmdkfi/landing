---
import { statusSection, visual, groupOrder, groupLabel, statusLabel, statusMeaning, featuresOf, type Group } from '../../content/landing.ts';
const groups = groupOrder.map((id) => ({ id, label: groupLabel[id], items: featuresOf(id) }));
const symbols: Record<Group, string> = { collateral: '◇', borrow: '$', venue: '⌘', chain: '↗', market: '↗', 'venue-risk': '◈', control: '◎', strategy: '✦' };
const itemSymbols: Record<string, string> = { eth: '◇', btc: '₿', stocks: '▤', 'more-assets': '✦', gold: '◈', rwa: '▦', usdc: '$', 'best-rate': '%', 'morpho-base': 'M', aave: 'A', rhea: 'R', kamino: 'K', 'base-near': '↗', 'any-chain': '∞' };
---
<section class="roadmap" id="roadmap" aria-labelledby="roadmap-title">
  <div class="roadmap-inner">
    <div class="roadmap-heading">
      <p class="roadmap-kicker">{visual.directoryTitle}</p>
      <h2 id="roadmap-title">{visual.assetsTitle}</h2>
      <p>{visual.directoryIntro}</p>
    </div>
    <div class="roadmap-tabs" role="group" aria-label={visual.directoryTitle}>
      {groups.map((group, index) => <label class="roadmap-tab"><input type="radio" name="concept-roadmap-category" value={group.id} checked={index === 0} /><span>{group.label}</span><span class="roadmap-count">{group.items.length}</span></label>)}
    </div>
    {groups.map((group) => <div class="roadmap-panel" id={`roadmap-${group.id}`}>
      <div class="roadmap-feature">
        <div class="roadmap-feature-copy">
          <div class="roadmap-feature-label"><span class={`roadmap-icon roadmap-icon-${group.id}`} aria-hidden="true">{symbols[group.id]}</span><span>{group.items[0].title}</span></div>
          <div class="roadmap-feature-body"><h3>{group.items[0].text}</h3><p>{statusMeaning[group.items[0].status]}</p><div class="roadmap-feature-actions"><a href={`#roadmap-list-${group.id}`}>{visual.directoryExplore}</a><span class="roadmap-status" data-status={group.items[0].status}>{statusLabel[group.items[0].status]}</span></div></div>
        </div>
        <div class="roadmap-stage" aria-hidden="true">
          <div class="roadmap-window">
            <div class="roadmap-window-bar"><span class="roadmap-window-mark">{visual.directoryWindowMark}</span><span>{visual.directoryWindowBrand}</span><span class="roadmap-window-path">{visual.directoryWindowPath}</span></div>
            <div class="roadmap-window-content"><div class="roadmap-window-sidebar"><span></span><span></span><span></span><span></span></div><div class="roadmap-window-body">
              <div class="roadmap-window-head"><span>{group.label}</span><span>{group.items.length}</span></div>
              <div class="roadmap-window-list">{group.items.slice(0, 3).map((item, index) => <div class="roadmap-window-row" data-selected={index === 0 ? '' : undefined}><span class={`roadmap-window-icon roadmap-icon-${group.id}`}>{itemSymbols[item.id] ?? symbols[group.id]}</span><span class="roadmap-window-title">{item.title}</span><span class="roadmap-window-dot" data-status={item.status}></span></div>)}</div>
            </div></div>
          </div>
          <div class="roadmap-stage-detail" data-status={group.items[0].status}><span class="roadmap-stage-detail-label">{statusSection.columns.status}</span><strong>{statusLabel[group.items[0].status]}</strong><span class="roadmap-stage-detail-count">{group.items.filter((item) => item.status === 'live').length} / {group.items.length} {statusLabel.live}</span></div>
        </div>
      </div>
      <ul class="roadmap-grid" id={`roadmap-list-${group.id}`}>{group.items.slice(1).map((item) => <li class="roadmap-card"><span class={`roadmap-icon roadmap-icon-${group.id}`} aria-hidden="true">{itemSymbols[item.id] ?? symbols[group.id]}</span><div class="roadmap-card-copy"><h3>{item.title}</h3><p>{item.text}</p></div><span class="roadmap-status" data-status={item.status}>{statusLabel[item.status]}</span></li>)}</ul>
    </div>)}
    <p class="roadmap-note">{statusSection.footnote}</p>
  </div>
</section>

<style>
  .roadmap{position:relative;background:#fff;color:#111318;padding:clamp(90px,10vw,150px) 20px 130px;border-top:1px solid #e4e5e7;font-family:Kecal,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
  .roadmap-inner{max-width:1240px;margin-inline:auto}.roadmap-heading{max-width:1120px}.roadmap-kicker{margin:0 0 24px;color:#777b84;font-size:12px;font-weight:650;letter-spacing:.11em;text-transform:uppercase}.roadmap-heading h2{margin:0;font-size:clamp(44px,4.8vw,68px);font-weight:600;line-height:1.03;letter-spacing:-.055em}.roadmap-heading>p:last-child{max-width:620px;margin:24px 0 0;color:#656972;font-size:clamp(17px,1.7vw,22px);line-height:1.48}
  .roadmap-tabs{display:flex;gap:8px;overflow-x:auto;margin:66px 0 36px;padding:2px 2px 8px;scrollbar-width:thin}.roadmap-tab{position:relative;display:flex;align-items:center;gap:12px;flex:none;min-height:46px;padding:9px 16px;border:1px solid #e0e2e5;border-radius:11px;background:#fff;color:#747780;font-size:15px;line-height:1.2;cursor:pointer;transition:border-color .16s ease,background .16s ease,color .16s ease}.roadmap-tab:hover{background:#f8f9fb;color:#111318}.roadmap-tab:has(input:checked){background:#f7f8fa;border-color:#bfc3ca;color:#111318}.roadmap-tab:has(input:focus-visible){outline:3px solid #596775;outline-offset:3px}.roadmap-tab input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:pointer}.roadmap-count{display:grid;place-items:center;min-width:23px;height:23px;padding-inline:5px;border-radius:7px;background:#e9ebee;color:#777b84;font-size:12px;font-variant-numeric:tabular-nums}
  .roadmap-panel{display:none}.roadmap:has(input[value="market"]:checked) #roadmap-market,.roadmap:has(input[value="venue-risk"]:checked) #roadmap-venue-risk,.roadmap:has(input[value="collateral"]:checked) #roadmap-collateral,.roadmap:has(input[value="borrow"]:checked) #roadmap-borrow,.roadmap:has(input[value="venue"]:checked) #roadmap-venue,.roadmap:has(input[value="chain"]:checked) #roadmap-chain,.roadmap:has(input[value="control"]:checked) #roadmap-control,.roadmap:has(input[value="strategy"]:checked) #roadmap-strategy{display:block}
  .roadmap-feature{display:grid;grid-template-columns:1.2fr 1fr;gap:26px;min-height:390px;padding:28px;border:1px solid #e5e6e9;border-radius:30px;background:#fafbfc;overflow:hidden}.roadmap-feature-copy{display:flex;align-items:flex-start;flex-direction:column;justify-content:center;padding:20px 12px}.roadmap-feature-label{margin-top:14px;color:#4c5058;font-size:14px;font-weight:550}.roadmap-feature h3{margin:32px 0 0;font-size:clamp(30px,3vw,45px);font-weight:550;line-height:1.1;letter-spacing:-.035em}.roadmap-feature-copy>p{margin:12px 0 0;color:#686c75;font-size:18px;line-height:1.5}.roadmap-feature .roadmap-status{margin-top:22px}.roadmap-art{position:relative;display:grid;place-items:center;min-height:330px;border:1px solid #dce5e5;border-radius:23px;overflow:hidden;background:radial-gradient(circle at 62% 42%,#f7fbfb 0,#e5f0ee 42%,#c6dfd9 100%)}.roadmap-art-borrow{background:radial-gradient(circle at 62% 42%,#fafcf9 0,#e9f1e3 45%,#cddfbe 100%)}.roadmap-art-venue{background:radial-gradient(circle at 62% 42%,#f9fbfd 0,#e5edf5 45%,#c6d6e7 100%)}.roadmap-art-chain{background:radial-gradient(circle at 62% 42%,#fbfafc 0,#eee8f3 45%,#d7c9e2 100%)}.roadmap-art-ring{position:absolute;width:240px;height:240px;border:1px solid #fff;border-radius:50%;box-shadow:0 0 0 50px #ffffff47,0 0 0 100px #ffffff29}.roadmap-art-symbol{position:relative;display:grid;place-items:center;width:135px;height:135px;border:1px solid #ffffffd9;border-radius:32px;background:linear-gradient(145deg,#fff9,#ffffff4d);box-shadow:0 26px 60px #57646b2b,inset 0 1px #fff;color:#346c69;font-size:79px;line-height:1}.roadmap-art-caption{position:absolute;right:22px;bottom:18px;color:#52666b;font-size:12px;font-weight:600}
  .roadmap-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:18px 0 0;padding:0;list-style:none}.roadmap-card{display:grid;grid-template-columns:56px minmax(0,1fr);gap:17px;min-height:148px;padding:22px;border:1px solid #e5e6e9;border-radius:26px;background:#fafbfc}.roadmap-icon{display:grid;place-items:center;width:56px;height:56px;border:1px solid #c4d8d4;border-radius:17px;background:linear-gradient(145deg,#d5eff0,#a7d2cb 55%,#f2e1c8);box-shadow:inset 0 1px #fff9;color:#246762;font-size:30px;line-height:1}.roadmap-icon-borrow{background:linear-gradient(145deg,#e9f2da,#bed7ad 60%,#f2e6c8);color:#4e7048}.roadmap-icon-venue{background:linear-gradient(145deg,#dfebf9,#a9cae0 60%,#e9e0f0);color:#396c86}.roadmap-icon-chain{background:linear-gradient(145deg,#f0e7fa,#cdbddd 60%,#e5e6f3);color:#705c83}.roadmap-card h3{margin:2px 0 0;font-size:19px;font-weight:560;line-height:1.25;letter-spacing:-.02em}.roadmap-card p{margin:7px 0 13px;color:#737780;font-size:14px;line-height:1.4}.roadmap-status{display:inline-flex;align-items:center;min-height:27px;padding:4px 10px;border:1px solid #dce1e3;border-radius:999px;background:#eff1f2;color:#596167;font-size:11px;font-weight:600;line-height:1.2;white-space:nowrap}.roadmap-status[data-status="live"]{border-color:#c7ded3;background:#e5f2e9;color:#2d7050}.roadmap-status[data-status="production"]{border-color:#e9d4a9;background:#f9f1de;color:#916015}.roadmap-note{margin:22px 0 0;color:#767b83;font-size:14px;line-height:1.5}
  @media(max-width:760px){.roadmap{padding:80px 18px 100px}.roadmap-tabs{margin-top:44px}.roadmap-feature{grid-template-columns:1fr;padding:18px;gap:18px}.roadmap-feature-copy{padding:16px 6px}.roadmap-art{min-height:230px}.roadmap-grid{grid-template-columns:1fr}.roadmap-card{min-height:120px}}@media(max-width:480px){.roadmap-heading h2{font-size:43px}.roadmap-feature h3{font-size:32px}.roadmap-art{min-height:190px}.roadmap-art-symbol{width:100px;height:100px;font-size:62px;border-radius:25px}.roadmap-card{padding:17px;border-radius:20px}.roadmap-icon{width:48px;height:48px;border-radius:14px;font-size:26px}.roadmap-card{grid-template-columns:48px minmax(0,1fr)}}@media(prefers-reduced-motion:reduce){.roadmap-tab{transition:none}}
  /* The directory follows the compact app-card rhythm of the reference, in cmdk's gray. */
  .roadmap{background:#f5f6f6}.roadmap-tab{background:#f8f9fa;border-radius:10px}.roadmap-feature{grid-template-columns:1.35fr 1fr;min-height:380px;padding:34px;border-radius:30px;background:#fff}.roadmap-feature-copy{justify-content:space-between;padding:5px 0}.roadmap-feature-label{display:flex;align-items:center;gap:12px;margin:0;color:#191b20;font-size:19px;font-weight:550}.roadmap-feature-label .roadmap-icon{width:40px;height:40px;border-radius:11px;font-size:23px}.roadmap-feature h3{max-width:570px;margin:auto 0 0;font-size:clamp(22px,2.2vw,32px);font-weight:500;line-height:1.35;letter-spacing:-.025em}.roadmap-feature .roadmap-status{margin-top:20px}
  @media(min-width:761px){.roadmap-tabs{flex-wrap:wrap;overflow:visible}}
  .roadmap-art{display:flex;flex-direction:column;align-items:stretch;justify-content:flex-end;min-height:310px;padding:26px;border:1px solid #e8e9ed;border-radius:26px;background:#fff;box-shadow:0 0 0 12px #f6f7f8,0 20px 40px #1e242b0b}.roadmap-art-heading{display:flex;justify-content:space-between;gap:20px;color:#373a41;font-size:17px}.roadmap-art-heading span:last-child{color:#a1a4aa}.roadmap-art-metric{margin-top:18px;font-size:44px;line-height:1;letter-spacing:-.04em}.roadmap-art-metric span{color:#adb0b5;font-size:24px}.roadmap-art>p{margin:7px 0 25px;color:#8b8e95;font-size:13px}.roadmap-bars{display:flex;align-items:flex-end;gap:6px;height:60px}.roadmap-bars span{flex:1;height:52%;min-width:4px;border-radius:3px 3px 0 0;background:#c9cdd2}.roadmap-bars span:nth-child(3n+1){height:68%}.roadmap-bars span:nth-child(4n+2){height:86%}.roadmap-bars span[data-status="live"]{background:#6b9a8c}.roadmap-bars span[data-status="production"]{background:#e0ba77}.roadmap-bars span[data-status="roadmap"]{background:#a7b9ca}.roadmap-bars span[data-status="exploring"]{background:#d6d8dc}.roadmap-art-legend{display:flex;flex-wrap:wrap;gap:7px 13px;margin-top:17px;color:#8a8e95;font-size:10px}.roadmap-art-legend span{display:inline-flex;align-items:center;gap:4px}.roadmap-art-legend i{display:inline-block;width:6px;height:6px;border-radius:2px;background:#d6d8dc}.roadmap-art-legend i[data-status="live"]{background:#6b9a8c}.roadmap-art-legend i[data-status="production"]{background:#e0ba77}.roadmap-art-legend i[data-status="roadmap"]{background:#a7b9ca}.roadmap-art-legend b{font-weight:600}
  .roadmap-grid{gap:14px;margin-top:26px}.roadmap-card{grid-template-columns:56px minmax(0,1fr) auto;align-items:center;min-height:95px;padding:14px 17px;border-radius:999px;background:#fff}.roadmap-card-copy{min-width:0}.roadmap-card h3{margin:0;font-size:17px}.roadmap-card p{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;margin:4px 0 0;color:#82858d;font-size:13px;line-height:1.3}.roadmap-card>.roadmap-status{justify-self:end;align-self:center;margin-left:4px;border:0;border-radius:8px;background:#f0f1f2;color:#777b82}.roadmap-card>.roadmap-status[data-status="live"]{background:#e7f0eb;color:#3f785d}.roadmap-card>.roadmap-status[data-status="production"]{background:#f8f0e2;color:#976b29}
  @media(max-width:760px){.roadmap-feature{grid-template-columns:1fr}.roadmap-feature-copy{min-height:215px}.roadmap-art{min-height:260px}.roadmap-card{min-height:90px}}@media(max-width:480px){.roadmap-feature{padding:20px}.roadmap-feature h3{font-size:24px}.roadmap-art{padding:20px;min-height:240px}.roadmap-card{grid-template-columns:48px minmax(0,1fr);border-radius:22px}.roadmap-card>.roadmap-status{grid-column:2;justify-self:start;margin:3px 0 0}.roadmap-card p{-webkit-line-clamp:3}}
  .roadmap{background:#fff}.roadmap-feature{border-color:#e9eaed;background:#fff}.roadmap-card{border-color:#e9eaed;background:#fff}.roadmap-feature-copy{justify-content:space-between}.roadmap-feature-body{margin-top:auto}.roadmap-feature h3{margin:0}.roadmap-feature-body>p{max-width:510px;margin:15px 0 0;color:#777b83;font-size:17px;line-height:1.48}.roadmap-feature-actions{display:flex;align-items:center;gap:12px;margin-top:25px}.roadmap-feature-actions>a{display:inline-flex;align-items:center;min-height:34px;padding:6px 15px;border-radius:999px;background:#f0f1f2;color:#191b20;font-size:14px;text-decoration:none;transition:background .16s ease}.roadmap-feature-actions>a:hover{background:#e4e6e8}.roadmap-feature-actions>a:focus-visible{outline:3px solid #596775;outline-offset:3px}.roadmap-feature .roadmap-status{margin:0}.roadmap-grid{scroll-margin-top:96px}
  @media(max-width:760px){.roadmap-feature-copy{min-height:260px}.roadmap-feature-body>p{font-size:15px}}
  .roadmap-tabs{gap:8px}.roadmap-tab{min-height:42px;padding:7px 13px;border:0;border-radius:999px;background:oklch(.966 .004 260);color:oklch(.51 .016 260);font-size:14px;font-weight:500;box-shadow:none}.roadmap-tab:hover{background:oklch(.94 .006 260);color:#181a1f}.roadmap-tab:has(input:checked){border:0;border-radius:999px;background:oklch(.91 .006 260);color:#181a1f;box-shadow:none}.roadmap-count{min-width:20px;height:20px;padding-inline:4px;border-radius:999px;background:#fff9;color:#696d75;font-size:11px;font-weight:500}
  .roadmap-heading{max-width:760px}.roadmap-kicker{margin:0 0 20px;color:#69727e;font-family:var(--font-technical);font-size:12px;font-weight:500;line-height:1.5;letter-spacing:.06em}.roadmap-kicker::before{content:'// ';color:#8d96a1}.roadmap-heading h2{color:#2d323c;font-size:clamp(36px,3.5vw,48px);font-weight:540;line-height:1.08;letter-spacing:-.055em;text-wrap:balance}.roadmap-heading>p:last-child{max-width:60ch;margin-top:24px;color:#59616d;font-size:16px;line-height:1.6;text-wrap:pretty}
  .roadmap-card{border-radius:22px}
  @media(max-width:480px){.roadmap-heading h2{font-size:36px}.roadmap-card{border-radius:18px}}
  .roadmap-stage{position:relative;min-width:0;min-height:310px;overflow:hidden;border-radius:24px;background:transparent}.roadmap-window{position:absolute;top:18px;left:116px;width:540px;height:340px;overflow:hidden;border:1px solid #e6e8eb;border-radius:16px;background:#fff;box-shadow:0 16px 36px #252d391a}.roadmap-window-bar{display:flex;align-items:center;gap:8px;height:44px;padding:0 16px;border-bottom:1px solid #eceef0;color:#2d323c;font-size:12px;font-weight:600}.roadmap-window-mark{display:grid;place-items:center;width:22px;height:22px;border-radius:6px;background:#eef0f3;color:#495360;font-size:11px;letter-spacing:-.12em}.roadmap-window-path{color:#a0a6ad;font-weight:400}.roadmap-window-content{display:flex;height:calc(100% - 44px)}.roadmap-window-sidebar{display:flex;flex:none;flex-direction:column;gap:17px;width:116px;padding:25px 17px;border-right:1px solid #eceef0;background:#f8f9fa}.roadmap-window-sidebar span{height:7px;border-radius:4px;background:#e1e5e8}.roadmap-window-sidebar span:nth-child(1){width:35px;height:17px;margin-bottom:5px;border-radius:6px}.roadmap-window-sidebar span:nth-child(2){width:66px}.roadmap-window-sidebar span:nth-child(3){width:51px}.roadmap-window-sidebar span:nth-child(4){width:73px}.roadmap-window-body{min-width:0;flex:1;padding:23px 20px}.roadmap-window-head{display:flex;justify-content:space-between;gap:12px;margin-bottom:21px;color:#333a43;font-size:15px;font-weight:600}.roadmap-window-head span:last-child{color:#9aa1a9;font-size:12px;font-variant-numeric:tabular-nums}.roadmap-window-list{display:grid;gap:9px}.roadmap-window-row{display:flex;align-items:center;gap:10px;min-height:47px;padding:7px 9px;border:1px solid #eff0f2;border-radius:10px;background:#fff}.roadmap-window-row[data-selected]{border-color:#d9e7e1;background:#f1f7f4}.roadmap-window-icon{display:grid;flex:none;place-items:center;width:26px;height:26px;border-radius:7px;background:#e5eeeb;color:#386d5c;font-size:15px;font-weight:600}.roadmap-window-title{min-width:0;overflow:hidden;color:#40464f;font-size:11px;font-weight:500;text-overflow:ellipsis;white-space:nowrap}.roadmap-window-dot{flex:none;width:7px;height:7px;margin-left:auto;border-radius:50%;background:#b8bec6}.roadmap-window-dot[data-status="live"]{background:#6b9a8c}.roadmap-window-dot[data-status="production"]{background:#d5ad66}.roadmap-window-dot[data-status="roadmap"]{background:#9eafc3}.roadmap-stage-detail{position:absolute;bottom:20px;left:18px;display:flex;flex-direction:column;gap:7px;width:190px;min-height:118px;padding:15px 16px;border:1px solid #e6e8eb;border-radius:15px;background:#fff;box-shadow:0 10px 24px #252d3924}.roadmap-stage-detail-label{color:#89909a;font-size:11px}.roadmap-stage-detail strong{color:#2f7255;font-size:15px;font-weight:600;line-height:1.25}.roadmap-stage-detail-count{margin-top:auto;color:#777f89;font-size:10px;font-variant-numeric:tabular-nums}
  @media(max-width:760px){.roadmap-stage{min-height:265px}.roadmap-window{top:0;left:0;width:100%;height:100%;border-radius:15px;box-shadow:none}.roadmap-window-sidebar,.roadmap-stage-detail{display:none}.roadmap-window-body{padding:20px}.roadmap-window-title{font-size:12px}.roadmap-window-row{min-height:48px}}
  @media(min-width:761px){.roadmap-window{left:55px}.roadmap-window-sidebar{width:90px;padding-inline:15px}.roadmap-window-sidebar span:nth-child(n){max-width:58px}.roadmap-stage-detail{width:145px}.roadmap-stage-detail strong{font-size:13px}.roadmap-stage-detail-count{font-size:9px}}
  .roadmap{scroll-margin-top:88px}.roadmap-tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;overflow:visible;margin:48px 0 30px;padding:0}.roadmap-tab{min-width:0;justify-content:space-between;padding-inline:16px}.roadmap-tab>span:first-of-type{min-width:0}.roadmap-tab:has(input:checked){background:#e8eaed}.roadmap-count{flex:none}.roadmap-card p{display:block;overflow:visible;-webkit-line-clamp:unset;margin-bottom:0}.roadmap-stage-detail[data-status="production"] strong{color:#916015}.roadmap-stage-detail[data-status="roadmap"] strong,.roadmap-stage-detail[data-status="exploring"] strong{color:#596167}
  @media(max-width:900px){.roadmap-tabs{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:520px){.roadmap-tabs{display:flex;gap:8px;overflow-x:auto;scroll-snap-type:x proximity;margin-top:36px;padding-bottom:10px;scrollbar-width:thin}.roadmap-tab{scroll-snap-align:start;min-height:44px;white-space:nowrap}.roadmap-card p{display:block;-webkit-line-clamp:unset}}
</style>
