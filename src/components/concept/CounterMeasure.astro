---
import { problem, forWhom } from '../../content/landing';
import { protectionPlayer as copy } from '../../content/protection-player';
import { readableCopy } from '../../utils/typography';
const story = readableCopy(problem);
const audience = readableCopy(forWhom);
---
<section class="origin-map" id="counter-measure" aria-labelledby="loan-care-title">
  <div class="sky-field" aria-hidden="true"><i></i><i></i></div>
  <div class="care-layout">
    <header class="care-intro"><p>{copy.contextLabel}</p><h2 id="loan-care-title">{story.h2}</h2><p class="care-closing">{story.closing}</p></header>
    <section class="price-protection care-story" data-demo-kind="context" aria-label={copy.contextLabel}>
      <div class="borrow-show-controls" role="group" aria-label={copy.contextLabel}>
        <button type="button" data-watch aria-pressed="false">{copy.watch}</button><button type="button" data-pause disabled>{copy.pause}</button><button type="button" data-replay>{copy.replay}</button>
      </div>
      <div data-protection-page class="care-beat"><span class="care-number" aria-hidden="true">01</span><h3>{story.blocks[0].title}</h3><p>{story.blocks[0].text}</p><ul>{story.blocks[0].facts.map(fact => <li>{fact}</li>)}</ul></div>
      <div data-protection-page hidden>
        {story.blocks.slice(1).map((beat,index) => <div data-feature-page hidden class="care-beat"><span class="care-number" aria-hidden="true">0{index+2}</span><h3>{beat.title}</h3><p>{beat.text}</p></div>)}
        <div data-feature-page hidden class="care-beat"><span class="care-number" aria-hidden="true">04</span><h3>{audience.h2}</h3><p>{audience.body}</p><p>{audience.yourPart}</p></div>
        <div data-feature-page hidden class="care-beat"><span class="care-number" aria-hidden="true">05</span><h3>{copy.controlTitle}</h3><p>{copy.agent}</p><p>{audience.yourPart}</p><p>{copy.controlNote}</p></div>
      </div>
      <nav class="care-nav" aria-label={copy.contextLabel}><button type="button" data-prev disabled>{copy.back}</button><span data-page-label aria-live="polite">1 / 5</span><button type="button" data-next>{copy.next}</button></nav>
    </section>
  </div>
</section>
<style>
.origin-map{position:relative;isolation:isolate;overflow:hidden;width:var(--page-width);max-width:none;margin:var(--section-space) auto 0;padding:var(--panel-inset);border-radius:32px;color:#102b42;background:radial-gradient(ellipse at 70% 18%,#eaf8ff 0%,#a7daf8 34%,#79bee8 67%,#417da7 100%);scroll-margin-top:90px;}
.care-layout{position:relative;z-index:1;display:grid;grid-template-columns:var(--demo-columns);align-items:center;gap:var(--grid-gap);}
.care-intro h2{font-size:clamp(28px,3.2vw,44px);line-height:1.12;letter-spacing:-.04em;text-wrap:balance;max-width:18ch;}
.care-intro p{font-size:15px;line-height:1.6;}.care-closing{color:white;}
.care-story{display:flex;flex-direction:column;min-width:0;min-height:490px;background:white;border-radius:24px;overflow:hidden;color:#273846;box-shadow:0 12px 36px #102b4215;}
.care-beat{padding:24px 28px;}.care-number{font:14px var(--font-technical);color:#667580;}.care-beat h3{font-size:26px;line-height:1.2;letter-spacing:-.03em;margin:20px 0 14px;}.care-beat p,.care-beat li{font-size:16px;line-height:1.55;text-wrap:pretty;}.care-beat ul{padding-left:20px;}.care-beat li+li{margin-top:12px;}
.care-nav{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding:12px 24px;border-top:1px solid #e3e7eb;}.care-nav button{border:0;border-radius:30px;background:#f1f2f4;padding:12px 16px;min-height:44px;color:inherit;cursor:pointer;}.care-nav button:disabled{opacity:.4;cursor:default;}.care-nav button:focus-visible{outline:2px solid #48667d;outline-offset:2px;}.care-nav span{font-size:12px;}
[hidden]{display:none!important;}
@media(max-width:800px){.origin-map{padding:24px 16px;}.care-layout{grid-template-columns:1fr;gap:24px;}.care-intro h2{max-width:26ch;}.care-story{min-height:560px;}.care-beat{padding:20px;}.care-beat h3{font-size:24px;}}
  .sky-field { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .sky-field::before { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, #0a395f 0%, #205d889c 25%, transparent 67%); }
  .sky-field::after { content: ''; position: absolute; inset: 0; opacity: .38; background: url('/images/sky-grain.svg') 0 0 / 180px 180px; mix-blend-mode: multiply; }
  .sky-field i { position: absolute; display: block; width: 72%; height: 70%; border-radius: 50%; background: radial-gradient(ellipse, #f2fbffb3 0%, #d0ebfb77 38%, transparent 72%); will-change: transform; }
  .sky-field i:first-child { top: -27%; right: -18%; }
  .sky-field i:last-child { left: -29%; bottom: -27%; width: 66%; height: 78%; background: radial-gradient(ellipse, #8bd3f4aa 0%, #5daedb55 43%, transparent 73%); }

</style>
<script>
  import { gsap } from 'gsap';

  function setupSkyMotion() {
    document.querySelectorAll<HTMLElement>('.origin-map, .dial-wheel').forEach(section => {
      if (section.dataset.skyReady) return;
      section.dataset.skyReady = 'true';
      const glows = [...section.querySelectorAll<HTMLElement>('.sky-field i, .dial-sky i')];
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      const tweens = [
        gsap.to(glows[0], { xPercent: -6, yPercent: 5, duration: 24, ease: 'sine.inOut', repeat: -1, yoyo: true, paused: true }),
        gsap.to(glows[1], { xPercent: 8, yPercent: -6, duration: 30, ease: 'sine.inOut', repeat: -1, yoyo: true, paused: true }),
      ];
      let visible = false;
      const sync = () => {
        const active = visible && !document.hidden && !reduced.matches;
        tweens.forEach(tween => active ? tween.play() : tween.pause());
        if (reduced.matches) gsap.set(glows, { clearProps: 'transform' });
      };
      const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); });
      observer.observe(section);
      reduced.addEventListener('change', sync);
      document.addEventListener('visibilitychange', sync);
    });
  }

  function setupCollateralSelect() {
    document.querySelectorAll<HTMLDetailsElement>('.collateral-select').forEach(select => {
      if (select.dataset.ready) return;
      select.dataset.ready = 'true';
      const trigger = select.querySelector<HTMLElement>('summary')!;
      const menu = select.querySelector<HTMLElement>('.collateral-options')!;
      const rows = [...menu.querySelectorAll<HTMLElement>('.collateral-option')];
      const current = menu.querySelector<HTMLButtonElement>('.collateral-current')!;
      const closeButton = menu.querySelector<HTMLButtonElement>('.collateral-close')!;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let closing = false;

      function open() {
        if (closing) return;
        select.open = true;
        if (!reduced.matches) {
          gsap.killTweensOf([menu, ...rows]);
          gsap.fromTo(menu, { opacity: 0, scale: .84, y: -7 }, { opacity: 1, scale: 1, y: 0, duration: .32, ease: 'back.out(1.2)', clearProps: 'transform,opacity' });
          gsap.fromTo(rows, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: .22, stagger: .035, delay: .09, ease: 'power2.out', clearProps: 'transform,opacity' });
        }
        current.focus({ preventScroll: true });
      }
      function close(restoreFocus = true) {
        if (!select.open || closing) return;
        if (reduced.matches) { select.open = false; if (restoreFocus) trigger.focus({ preventScroll: true }); return; }
        closing = true;
        gsap.killTweensOf([menu, ...rows]);
        gsap.to(menu, { opacity: 0, scale: .86, y: -6, duration: .2, ease: 'power2.in', onComplete: () => {
          select.open = false;
          closing = false;
          gsap.set([menu, ...rows], { clearProps: 'transform,opacity' });
          if (restoreFocus) trigger.focus({ preventScroll: true });
        } });
      }
      trigger.addEventListener('click', event => { event.preventDefault(); select.open ? close() : open(); });
      current.addEventListener('click', () => close());
      closeButton.addEventListener('click', () => close());
      select.addEventListener('keydown', event => { if (event.key === 'Escape') { event.preventDefault(); close(); } });
      document.addEventListener('pointerdown', event => { if (select.open && !select.contains(event.target as Node)) close(false); });
    });
  }
  setupCollateralSelect();
  setupSkyMotion();
  document.addEventListener('astro:page-load', () => { setupCollateralSelect(); setupSkyMotion(); });
</script>
