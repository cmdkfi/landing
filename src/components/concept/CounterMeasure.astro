---
import { counterMeasure as copy } from "../../content/counter-measure";
---
<section class="origin-map" aria-labelledby="counter-measure-title" id="counter-measure">
<div class="origin-grid">
<div class="origin-copy">
<div class="eyebrow">{copy.text1}</div>
<h2 id="counter-measure-title">{copy.text2}<br>{copy.text3}</h2>
<p>{copy.text4}</p>
<div class="micro">{copy.text5}<br>{copy.text6}</div>
</div>
<div class="map-mat">
<div class="map-card">
<div class="label">{copy.text7}</div>
<h2>{copy.text8}</h2>
<div class="legend">
<span>{copy.text9}</span>
<span>{copy.text10}</span>
</div>
<svg class="map-plot" viewBox="0 0 460 290" role="img" aria-label={copy.chartDescription}>
<g stroke="var(--chart-grid)" stroke-width="1">
<path d="M48 40H440M48 125H440M48 232H440"/>
</g>
<text x="0" y="44">{copy.text11}</text>
<text x="0" y="129">{copy.text12}</text>
<text x="0" y="236">{copy.text13}</text>
<path d="M48 232L112 218L179 181L245 125L294 89L350 40L350 250" fill="none" stroke="var(--chart-danger)" stroke-width="2" stroke-dasharray="4 5"/>
<path d="M48 232L112 218L179 181L245 125L290 232L440 232" fill="none" stroke="var(--chart-ink)" stroke-width="2.7" stroke-linejoin="round"/>
<circle cx="245" cy="125" r="5" fill="var(--chart-ink)" stroke="white" stroke-width="2"/>
<circle cx="350" cy="40" r="4" fill="var(--chart-danger)"/>
<circle cx="440" cy="232" r="4" fill="var(--chart-ink)"/>
<text class="red-text" x="276" y="23">{copy.text14}</text>
<text class="green-text" x="159" y="109">{copy.text15}</text>
<text class="green-text" x="313" y="216">{copy.text16}</text>
<text x="48" y="278">{copy.text17}</text>
<text x="326" y="278">{copy.text18}</text>
</svg>
<div class="map-note">{copy.text19}<br>{copy.text20}</div>
</div>
</div>
</div>
<div class="map-results">
<div class="map-stat">
<strong class="green">{copy.text21}</strong>
<div class="label">{copy.text22}</div>
<p>{copy.text23}</p>

</div>
<div class="map-stat">
<strong>{copy.text24}</strong>
<div class="label">{copy.text25}</div>
<p>{copy.text26}</p>
</div>
<div class="map-stat">
<strong>{copy.text27}</strong>
<div class="label">{copy.text28}</div>
<p>{copy.text29}</p>
</div>
</div>
<div class="foot">
<span class="proof">{copy.text30}</span>
</div>
</section>
<style>
  .origin-map {
    --chart-ink: #4b657a;
    --chart-danger: #b44440;
    --chart-grid: #d7dfe8;
    --ink: #273846;
    --muted: #596675;
    max-width: 1320px;
    margin: 0 auto;
    padding: 88px 48px 72px;
    color: #2d323c;
    background: #fff;
    scroll-margin-top: 90px;
    font-synthesis: none;
  }
  .origin-grid { display: grid; grid-template-columns: 1fr 1.08fr; gap: 64px; align-items: center; }
  .eyebrow, .label, .micro, .map-note, .proof { font-family: var(--font-technical); color: var(--muted); }
  .eyebrow, .label { font-size: 12px; line-height: 1.5; letter-spacing: .06em; }
  .origin-copy h2 { font-size: clamp(36px, 4vw, 58px); font-weight: 540; letter-spacing: -.055em; line-height: 1.08; margin: 20px 0 24px; text-wrap: balance; }
  .origin-copy > p { font-family: inherit; font-size: 16px; line-height: 1.6; color: #59616d; max-width: 43ch; text-wrap: pretty; }
  .micro { font-size: 12px; line-height: 1.7; margin-top: 28px; }
  .map-mat { padding: 24px; border-radius: 22px; background: #fff; border: 1px solid #e1e3e7; }
  .map-card { padding: 24px; border-radius: 20px; background: #fff; border: 1px solid #dfe3e8; box-shadow: 0 12px 30px #26364c12, 0 1px 2px #26364c0c; }
  .map-card h2 { font-size: clamp(22px, 2vw, 28px); font-weight: 540; letter-spacing: -.045em; line-height: 1.15; margin: 14px 0 18px; }
  .legend { display: flex; flex-wrap: wrap; gap: 12px 20px; font-size: 13px; line-height: 1.4; color: var(--muted); }
  .legend span { display: inline-flex; align-items: center; gap: 7px; }
  .legend span::before { content: ''; width: 16px; border-top: 2.5px solid var(--chart-ink); }
  .legend span + span::before { border-color: var(--chart-danger); border-top-style: dashed; }
  .map-plot { width: 100%; height: auto; display: block; margin-top: 24px; overflow: visible; }
  .map-plot text { font-family: var(--font-technical); font-size: 12px; fill: var(--muted); font-variant-numeric: tabular-nums; }
  .map-plot .green-text { fill: var(--chart-ink); }
  .map-plot .red-text { fill: var(--chart-danger); }
  .map-note { font-size: 12px; line-height: 1.65; border-top: 1px solid var(--chart-grid); padding-top: 16px; margin-top: 12px; }
  .map-results { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 32px; margin-top: 44px; padding-top: 28px; border-top: 1px solid var(--chart-grid); }
  .map-stat { min-width: 0; }
  .map-stat strong { display: block; font-family: var(--font-technical); font-size: clamp(32px, 3.8vw, 52px); font-weight: 500; letter-spacing: -.055em; line-height: 1.15; font-variant-numeric: tabular-nums; color: var(--ink); }
  .map-stat .label { margin-top: 14px; }
  .map-stat p { font-size: 14px; line-height: 1.5; color: var(--muted); margin: 8px 0 0; max-width: 25ch; }
  .foot { margin-top: 28px; }
  .proof { font-size: 12px; line-height: 1.5; }
  @media (max-width: 900px) {
    .origin-grid { grid-template-columns: 1fr; gap: 32px; }
    .origin-copy > p { max-width: 55ch; }
    .map-mat { max-width: 650px; width: 100%; }
  }
  @media (max-width: 600px) {
    .origin-map { padding: 56px 20px; }
    .origin-copy h2 { font-size: 36px; }
    .map-mat { padding: 12px; border-radius: 22px; }
    .map-card { padding: 18px 14px; border-radius: 12px; }
    .map-card h2 { font-size: 24px; }
    .map-plot text { font-size: 15px; }
    .map-results { grid-template-columns: 1fr; gap: 24px; margin-top: 32px; }
    .map-stat + .map-stat { border-top: 1px solid var(--chart-grid); padding-top: 24px; }
    .map-stat strong { font-size: 40px; }
    .map-stat p { max-width: 40ch; }
  }
</style>
