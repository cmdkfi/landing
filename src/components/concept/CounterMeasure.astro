---
import LtvChart from "./LtvChart";
import { counterMeasure as copy } from "../../content/counter-measure";
---
<section class="origin-map" aria-labelledby="counter-measure-title" id="counter-measure">
<div class="sky-field" aria-hidden="true"><i></i><i></i></div>
<div class="origin-grid">
<div class="origin-copy">
<div class="eyebrow">{copy.text1}</div>
<h2 id="counter-measure-title">{copy.text2}<br>{copy.text3}</h2>
<p>{copy.text4}</p>
<dl class="corridor-rules">
<div><dt>{copy.text13}</dt><dd>{copy.targetMeaning}</dd></div>
<div><dt>{copy.text12}</dt><dd>{copy.actMeaning}</dd></div>
<div><dt>{copy.text11}</dt><dd>{copy.lltvMeaning}</dd></div>
</dl>
<div class="micro">{copy.compactNote}</div>
</div>
<div class="origin-visual">
<div class="label position-label">{copy.positionLabel}</div>
<div class="map-mat">
<div class="map-card position-widget">
<div class="position-pair" aria-label={copy.pairDescription}>
<details class="collateral-select">
<summary class="pair-token" aria-label={copy.collateralTriggerLabel}><img src="/token-icons/eth.svg" alt="" width="36" height="36" />{copy.collateralSymbol}<span class="select-chevron" aria-hidden="true">⌄</span></summary>
<div class="collateral-options" aria-label={copy.collateralListLabel}>
<div class="collateral-menu-head"><span>{copy.collateralChooseLabel}</span><button type="button" class="collateral-close" aria-label={copy.collateralCloseLabel}>×</button></div>
<button type="button" class="collateral-option selected collateral-current"><span class="asset-icon"><img src="/token-icons/eth.svg" alt="" /></span><span>{copy.collateralOptions.eth.symbol}<small>{copy.collateralOptions.eth.status}</small></span><span class="asset-status">✓</span></button>
<div class="collateral-option unavailable"><span class="asset-icon">{copy.collateralOptions.btc.icon}</span><span>{copy.collateralOptions.btc.symbol}</span><span class="asset-status">{copy.collateralOptions.btc.status}</span></div>
<div class="collateral-option unavailable"><span class="asset-icon">{copy.collateralOptions.near.icon}</span><span>{copy.collateralOptions.near.symbol}</span><span class="asset-status">{copy.collateralOptions.near.status}</span></div>
<div class="collateral-option unavailable"><span class="asset-icon">{copy.collateralOptions.gold.icon}</span><span>{copy.collateralOptions.gold.symbol}</span><span class="asset-status">{copy.collateralOptions.gold.status}</span></div>
<div class="collateral-option unavailable"><span class="asset-icon">{copy.collateralOptions.stocks.icon}</span><span>{copy.collateralOptions.stocks.symbol}</span><span class="asset-status">{copy.collateralOptions.stocks.status}</span></div>
</div>
</details>
<span class="pair-arrow" aria-hidden="true"><img src="/cds-icons/arrowRight.svg" width="24" height="24" alt="" /></span>
<span class="pair-token debt-token"><img src="/token-icons/usdc.svg" alt="" width="36" height="36" />{copy.debtSymbol}</span>
</div>

<LtvChart client:visible />

</div>
</div>
</div>
<div class="map-results">
<div class="map-stat">
<strong class="green">{copy.text21}</strong>
<div class="label">{copy.text22}</div>
<p>{copy.text23}</p>

</div>
<div class="map-stat">
<strong>{copy.text24}</strong>
<div class="label">{copy.text25}</div>
<p>{copy.text26}</p>
</div>
<div class="map-stat">
<strong>{copy.text27}</strong>
<div class="label">{copy.text28}</div>
<p>{copy.text29}</p>
<a class="backtest-link" href={copy.sourceUrl}>{copy.sourceLabel}</a>
</div>
</div>
</div>

</section>
<style>
  .origin-map {
    --chart-ink: #4b657a;
    --chart-danger: #b44440;
    --chart-grid: #d7dfe8;
    --ink: #273846;
    --muted: #596675;
    max-width: 1320px;
    margin: 0 auto;
    padding: 88px 48px 72px;
    color: #2d323c;
    background: #fff;
    scroll-margin-top: 90px;
    font-synthesis: none;
  }
  .origin-grid > *, .map-card { min-width: 0; box-sizing: border-box; }
  .origin-visual { min-width: 0; display: flex; flex-direction: column; align-self: stretch; }
  .position-label { margin: 0 0 10px; }
  .origin-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(420px, 1.35fr) minmax(190px, .6fr); gap: 16px; align-items: stretch; }
  .origin-copy, .map-results { align-self: center; }
  .eyebrow, .label, .micro, .map-note, .proof { font-family: var(--font-technical); color: var(--muted); }
  .eyebrow, .label { font-size: 12px; line-height: 1.5; letter-spacing: .06em; }
  .origin-copy h2 { font-size: clamp(36px, 4vw, 58px); font-weight: 540; letter-spacing: -.055em; line-height: 1.08; margin: 20px 0 24px; text-wrap: balance; }
  .origin-copy > p { font-family: inherit; font-size: 16px; line-height: 1.6; color: #59616d; max-width: 43ch; text-wrap: pretty; }
  .micro { font-size: 12px; line-height: 1.7; margin-top: 28px; }
  .map-mat { padding: 24px; border-radius: 22px; background: #fff; border: 1px solid #e1e3e7; }
  .map-card { padding: 24px; border-radius: 20px; background: #fff; border: 1px solid #dfe3e8; box-shadow: 0 12px 30px #26364c12, 0 1px 2px #26364c0c; }
  .position-pair { display: flex; align-items: center; gap: 20px; margin-top: 16px; }
  .position-pair .pair-token, .position-pair > span { display: inline-flex; align-items: center; gap: 10px; font-size: 22px; font-weight: 540; }
  .collateral-select { position: relative; z-index: 5; }
  .collateral-select summary { cursor: pointer; list-style: none; touch-action: manipulation; }
  .collateral-select summary::-webkit-details-marker { display: none; }
  .collateral-select summary:focus-visible { outline: 2px solid #4b657a; outline-offset: 3px; }
  .select-chevron { font-size: 16px; color: #596675; }
  .collateral-options { position: absolute; top: -8px; left: -8px; z-index: 10; width: min(330px, calc(100vw - 64px)); padding: 10px; border: 1px solid #d7dfe8; border-radius: 20px; background: #fff; box-shadow: 0 16px 40px #26364c22; transform-origin: 32px 26px; }
  .collateral-menu-head { display: flex; justify-content: space-between; align-items: center; min-height: 32px; padding: 0 5px 5px; color: #68727c; font: 11px/1.3 var(--font-technical); }
  .collateral-close { width: 30px; height: 30px; border: 0; border-radius: 50%; background: transparent; color: #68727c; font-size: 20px; cursor: pointer; }
  .collateral-option { display: flex; align-items: center; gap: 9px; width: 100%; min-height: 42px; padding: 7px 9px; border: 0; border-radius: 10px; background: transparent; color: inherit; font: inherit; font-size: 13px; line-height: 1.2; text-align: left; }
  .collateral-current { cursor: pointer; }
  .collateral-current:focus-visible, .collateral-close:focus-visible { outline: 2px solid #4b657a; outline-offset: 2px; }
  .collateral-option + .collateral-option { border-top: 1px solid #edf0f3; }
  .collateral-option.selected { background: #e8f1ec; }
  .collateral-option.unavailable { color: #68727c; }
  .collateral-option small { display: block; margin-top: 2px; font-size: 10px; color: #4b6f5d; }
  .asset-icon { display: grid; flex: none; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: #f0f3f6; color: #2d7354; font-size: 12px; font-weight: 600; }
  .asset-icon img { width: 22px; height: 22px; }
  .asset-status { margin-left: auto; white-space: nowrap; font: 10px/1.2 var(--font-technical); }
  .selected .asset-status { color: #2d7354; font-size: 16px; }
  .position-pair img { display: block; width: 36px; height: 36px; object-fit: contain; }
  .position-pair .pair-arrow { color: var(--muted); font-size: 28px; font-weight: 400; }
  .map-card h2 { font-size: clamp(22px, 2vw, 28px); font-weight: 540; letter-spacing: -.045em; line-height: 1.15; margin: 14px 0 18px; }
  .map-note { font-size: 12px; line-height: 1.65; border-top: 1px solid var(--chart-grid); padding-top: 16px; margin-top: 12px; }
  .map-results { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 32px; margin-top: 44px; padding-top: 28px; border-top: 1px solid var(--chart-grid); }
  .map-stat { min-width: 0; }
  .map-stat strong { display: block; font-family: var(--font-technical); font-size: clamp(32px, 3.8vw, 52px); font-weight: 500; letter-spacing: -.055em; line-height: 1.15; font-variant-numeric: tabular-nums; color: var(--ink); }
  .map-stat .label { margin-top: 14px; }
  .map-stat p { font-size: 14px; line-height: 1.5; color: var(--muted); margin: 8px 0 0; max-width: 25ch; }
  .foot { margin-top: 28px; }
  .proof { font-size: 12px; line-height: 1.5; }
  @media (max-width: 900px) {
    .origin-grid { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .origin-copy > p { max-width: 55ch; }
    .map-mat { max-width: 650px; width: 100%; }
  }
  @media (max-width: 600px) {
    .origin-map { padding: 56px 20px; }
    .origin-copy h2 { font-size: 36px; }
    .map-mat { padding: 12px; border-radius: 22px; }
    .map-card { padding: 18px 14px; border-radius: 12px; }
    .map-card h2 { font-size: 24px; }
    .map-results { grid-template-columns: 1fr; gap: 24px; margin-top: 32px; }
    .map-stat + .map-stat { border-top: 1px solid var(--chart-grid); padding-top: 24px; }
    .map-stat strong { font-size: 40px; }
    .map-stat p { max-width: 40ch; }
  }

  .origin-map {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: 120px;
    border-radius: 32px;
    color: #102b42;
    background: radial-gradient(ellipse at 70% 18%, #eaf8ff 0%, #a7daf8 34%, #79bee8 67%, #417da7 100%);
  }
  .origin-grid, .map-results { position: relative; z-index: 1; }
  .map-mat { position: relative; padding: 34px; background: transparent; border-color: transparent; }
  .sky-field { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .sky-field::before { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, #0a395f 0%, #205d889c 25%, transparent 67%); }
  .sky-field::after { content: ''; position: absolute; inset: 0; opacity: .38; background: url('/images/sky-grain.svg') 0 0 / 180px 180px; mix-blend-mode: multiply; }
  .sky-field i { position: absolute; display: block; width: 72%; height: 70%; border-radius: 50%; background: radial-gradient(ellipse, #f2fbffb3 0%, #d0ebfb77 38%, transparent 72%); will-change: transform; }
  .sky-field i:first-child { top: -27%; right: -18%; }
  .sky-field i:last-child { left: -29%; bottom: -27%; width: 66%; height: 78%; background: radial-gradient(ellipse, #8bd3f4aa 0%, #5daedb55 43%, transparent 73%); }
  .map-card { position: relative; background: #fff; }
  @media (max-width: 600px) { .map-mat { padding: 22px 16px; } }



  .corridor-rules { margin: 26px 0; font: 12px/1.6 var(--font-technical); }
  .corridor-rules > div { display: grid; grid-template-columns: 66px 1fr; gap: 14px; padding: 12px 0; border-top: 1px solid #d7dfe8; }
  .corridor-rules dt { color: #273846; font-weight: 500; }
  .corridor-rules dd { color: #596675; margin: 0; }
  .scenario-label { font: 11px/1.5 var(--font-technical); color: #596675; margin: -8px 0 8px; }

  .map-stat { border-left: 1px solid #d7dfe8; padding-left: 24px; }
  .map-stat:first-child { border-left: 0; padding-left: 0; }
  .backtest-link { display: inline-block; font: 12px/1.5 var(--font-technical); color: #4b657a; text-underline-offset: 4px; padding: 12px 0; }
  .backtest-link:focus-visible { outline: 2px solid #555; outline-offset: 3px; }
  @media(max-width:600px) { .map-stat { border-left: 0; padding-left: 0; } }

  .origin-map { padding-block: 32px; scroll-margin-top: 72px; }
  .map-mat { display: flex; flex: 1; padding: 0; border: 0; border-radius: 38px 38px 0 0; background: transparent; box-shadow: none; }
  .map-card { flex: 1; width: 100%; padding: 16px 20px; border-radius: 38px 38px 0 0; background: #fff; color: #273846; border-color: #f9f9f9; box-shadow: 0 3px 9px #00000012, 0 12px 18px #0000000d; }
  .position-widget {
    --panel: #f5f6f8;
    --surface: #fff;
    --ltv-safe: var(--green);
    --ltv-safe-text: #216c4c;
    --ltv-warning: var(--amber);
    --ltv-danger: var(--red);
    --ltv-ink: #273846;
    --ltv-muted: #596675;
    --ltv-track: #e9ebee;
  }
  .position-widget .position-pair { margin-block: 8px; }
  .position-widget .position-pair .pair-token { background: var(--panel); border-radius: 24px; padding: 6px 12px 6px 6px; gap: 8px; font-size: 20px; }
  .position-widget .position-pair img { width: 28px; height: 28px; }
  .position-widget .position-pair .pair-arrow img { width: 20px; height: 20px; }

  .position-pair { margin-top: 8px; gap: 16px; }
  .position-pair .pair-arrow img { width: 24px; height: 24px; }
  .map-note { font: 12px/1.45 inherit; margin-top: 10px; padding-top: 10px; }
  .map-results { display: grid; grid-template-columns: 1fr; gap: 0; margin: 0; padding: 0 0 0 22px; border-top: 0; border-left: 1px solid #ffffff70; }
  .map-stat, .map-stat:first-child { border-left: 0; padding: 14px 0; }
  .map-stat + .map-stat { border-top: 1px solid #ffffff70; }
  .map-stat strong { font-size: clamp(29px, 2.5vw, 36px); line-height: 1; }
  .map-stat .label { margin-top: 8px; font-size: 11px; }
  .map-stat p { font-size: 12px; line-height: 1.4; margin-top: 4px; max-width: 38ch; }
  .backtest-link { padding: 4px 0; font-size: 11px; }
  .origin-map { padding-bottom: 0; }
  .origin-copy h2 { font-size: clamp(36px, 3.5vw, 48px); }
  .corridor-rules { margin-block: 18px; }
  .micro { margin-top: 18px; }
  .origin-copy h2, .origin-copy > p, .origin-copy .eyebrow, .origin-copy .micro,
  .origin-copy .corridor-rules dt, .origin-copy .corridor-rules dd,
  .position-label { color: #102b42; }
  .origin-copy > p, .origin-copy .corridor-rules dd, .origin-copy .micro { color: #244562; }
  .map-stat strong, .map-stat .label, .map-stat p, .backtest-link { color: #fff; }
  .map-stat:first-child strong, .map-stat:first-child .label, .map-stat:first-child p { color: #102b42; }
  .corridor-rules > div { border-color: #12375444; }
  .map-results, .map-stat { border-color: #ffffff70; }
  .backtest-link:focus-visible { outline-color: #fff; }
  @media(max-width:1150px) { .origin-map { padding-bottom: 32px; } .origin-grid { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 24px; } .origin-visual { grid-column: 2; } .map-mat, .map-card { border-radius: 38px; } .map-results { grid-column: 1 / -1; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 16px 0 0; border-left: 0; border-top: 1px solid #ffffff70; } .map-stat, .map-stat:first-child { padding: 0 16px; } .map-stat:first-child { padding-left: 0; } .map-stat + .map-stat { border-top: 0; border-left: 1px solid #ffffff70; } }
  @media(max-width:900px) { .origin-grid { grid-template-columns: 1fr; gap: 24px; } .origin-visual { grid-column: 1; } .origin-map { padding-block: 32px; } }
  @media(max-width:600px) { .origin-map { padding: 24px 20px; border-radius: 24px; } .map-mat { padding: 8px; border-radius: 34px; } .map-card { border-radius: 26px; } .map-results { grid-template-columns: 1fr; margin-top: 0; padding-top: 12px; } .map-stat, .map-stat:first-child { padding: 12px 0; } .map-stat + .map-stat { border-left: 0; border-top: 1px solid #ffffff70; } }
</style>
<script>
  import { gsap } from 'gsap';

  function setupSkyMotion() {
    document.querySelectorAll<HTMLElement>('.origin-map, .dial-wheel').forEach(section => {
      if (section.dataset.skyReady) return;
      section.dataset.skyReady = 'true';
      const glows = [...section.querySelectorAll<HTMLElement>('.sky-field i, .dial-sky i')];
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      const tweens = [
        gsap.to(glows[0], { xPercent: -6, yPercent: 5, duration: 24, ease: 'sine.inOut', repeat: -1, yoyo: true, paused: true }),
        gsap.to(glows[1], { xPercent: 8, yPercent: -6, duration: 30, ease: 'sine.inOut', repeat: -1, yoyo: true, paused: true }),
      ];
      let visible = false;
      const sync = () => {
        const active = visible && !document.hidden && !reduced.matches;
        tweens.forEach(tween => active ? tween.play() : tween.pause());
        if (reduced.matches) gsap.set(glows, { clearProps: 'transform' });
      };
      const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); });
      observer.observe(section);
      reduced.addEventListener('change', sync);
      document.addEventListener('visibilitychange', sync);
    });
  }

  function setupCollateralSelect() {
    document.querySelectorAll<HTMLDetailsElement>('.collateral-select').forEach(select => {
      if (select.dataset.ready) return;
      select.dataset.ready = 'true';
      const trigger = select.querySelector<HTMLElement>('summary')!;
      const menu = select.querySelector<HTMLElement>('.collateral-options')!;
      const rows = [...menu.querySelectorAll<HTMLElement>('.collateral-option')];
      const current = menu.querySelector<HTMLButtonElement>('.collateral-current')!;
      const closeButton = menu.querySelector<HTMLButtonElement>('.collateral-close')!;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let closing = false;

      function open() {
        if (closing) return;
        select.open = true;
        if (!reduced.matches) {
          gsap.killTweensOf([menu, ...rows]);
          gsap.fromTo(menu, { opacity: 0, scale: .84, y: -7 }, { opacity: 1, scale: 1, y: 0, duration: .32, ease: 'back.out(1.2)', clearProps: 'transform,opacity' });
          gsap.fromTo(rows, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: .22, stagger: .035, delay: .09, ease: 'power2.out', clearProps: 'transform,opacity' });
        }
        current.focus({ preventScroll: true });
      }
      function close(restoreFocus = true) {
        if (!select.open || closing) return;
        if (reduced.matches) { select.open = false; if (restoreFocus) trigger.focus({ preventScroll: true }); return; }
        closing = true;
        gsap.killTweensOf([menu, ...rows]);
        gsap.to(menu, { opacity: 0, scale: .86, y: -6, duration: .2, ease: 'power2.in', onComplete: () => {
          select.open = false;
          closing = false;
          gsap.set([menu, ...rows], { clearProps: 'transform,opacity' });
          if (restoreFocus) trigger.focus({ preventScroll: true });
        } });
      }
      trigger.addEventListener('click', event => { event.preventDefault(); select.open ? close() : open(); });
      current.addEventListener('click', () => close());
      closeButton.addEventListener('click', () => close());
      select.addEventListener('keydown', event => { if (event.key === 'Escape') { event.preventDefault(); close(); } });
      document.addEventListener('pointerdown', event => { if (select.open && !select.contains(event.target as Node)) close(false); });
    });
  }
  setupCollateralSelect();
  setupSkyMotion();
  document.addEventListener('astro:page-load', () => { setupCollateralSelect(); setupSkyMotion(); });
</script>
