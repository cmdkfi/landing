---
import LtvChart from "./LtvChart";
import { counterMeasure as copy } from "../../content/counter-measure";
---
<section class="origin-map" aria-labelledby="counter-measure-title" id="counter-measure">
<div class="origin-grid">
<div class="origin-copy">
<div class="eyebrow">{copy.text1}</div>
<h2 id="counter-measure-title">{copy.text2}<br>{copy.text3}</h2>
<p>{copy.text4}</p>
<dl class="corridor-rules">
<div><dt>{copy.text13}</dt><dd>{copy.targetMeaning}</dd></div>
<div><dt>{copy.text12}</dt><dd>{copy.actMeaning}</dd></div>
<div><dt>{copy.text11}</dt><dd>{copy.lltvMeaning}</dd></div>
</dl>
<div class="micro">{copy.compactNote}</div>
</div>
<div class="map-mat">
<div class="liquid-field" aria-hidden="true"><i></i><i></i><i></i></div>
<div class="map-card position-widget">
<div class="label">{copy.positionLabel}</div>
<div class="position-pair" aria-label={copy.pairDescription}>
<span><img src="/token-icons/eth.svg" alt="" width="36" height="36" />{copy.collateralSymbol}</span>
<span class="pair-arrow" aria-hidden="true"><img src="/cds-icons/arrowRight.svg" width="24" height="24" alt="" /></span>
<span><img src="/token-icons/usdc.svg" alt="" width="36" height="36" />{copy.debtSymbol}</span>
</div>

<LtvChart client:visible />

</div>
</div>
</div>
<div class="map-results">
<div class="map-stat">
<strong class="green">{copy.text21}</strong>
<div class="label">{copy.text22}</div>
<p>{copy.text23}</p>

</div>
<div class="map-stat">
<strong>{copy.text24}</strong>
<div class="label">{copy.text25}</div>
<p>{copy.text26}</p>
</div>
<div class="map-stat">
<strong>{copy.text27}</strong>
<div class="label">{copy.text28}</div>
<p>{copy.text29}</p>
<a class="backtest-link" href={copy.sourceUrl}>{copy.sourceLabel}</a>
</div>
</div>

</section>
<style>
  .origin-map {
    --chart-ink: #4b657a;
    --chart-danger: #b44440;
    --chart-grid: #d7dfe8;
    --ink: #273846;
    --muted: #596675;
    max-width: 1320px;
    margin: 0 auto;
    padding: 88px 48px 72px;
    color: #2d323c;
    background: #fff;
    scroll-margin-top: 90px;
    font-synthesis: none;
  }
  .origin-grid > *, .map-card { min-width: 0; box-sizing: border-box; }
  .origin-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr); gap: 64px; align-items: center; }
  .eyebrow, .label, .micro, .map-note, .proof { font-family: var(--font-technical); color: var(--muted); }
  .eyebrow, .label { font-size: 12px; line-height: 1.5; letter-spacing: .06em; }
  .origin-copy h2 { font-size: clamp(36px, 4vw, 58px); font-weight: 540; letter-spacing: -.055em; line-height: 1.08; margin: 20px 0 24px; text-wrap: balance; }
  .origin-copy > p { font-family: inherit; font-size: 16px; line-height: 1.6; color: #59616d; max-width: 43ch; text-wrap: pretty; }
  .micro { font-size: 12px; line-height: 1.7; margin-top: 28px; }
  .map-mat { padding: 24px; border-radius: 22px; background: #fff; border: 1px solid #e1e3e7; }
  .map-card { padding: 24px; border-radius: 20px; background: #fff; border: 1px solid #dfe3e8; box-shadow: 0 12px 30px #26364c12, 0 1px 2px #26364c0c; }
  .position-pair { display: flex; align-items: center; gap: 20px; margin-top: 16px; }
  .position-pair > span { display: inline-flex; align-items: center; gap: 10px; font-size: 22px; font-weight: 540; }
  .position-pair img { display: block; width: 36px; height: 36px; object-fit: contain; }
  .position-pair .pair-arrow { color: var(--muted); font-size: 28px; font-weight: 400; }
  .map-card h2 { font-size: clamp(22px, 2vw, 28px); font-weight: 540; letter-spacing: -.045em; line-height: 1.15; margin: 14px 0 18px; }
  .map-note { font-size: 12px; line-height: 1.65; border-top: 1px solid var(--chart-grid); padding-top: 16px; margin-top: 12px; }
  .map-results { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 32px; margin-top: 44px; padding-top: 28px; border-top: 1px solid var(--chart-grid); }
  .map-stat { min-width: 0; }
  .map-stat strong { display: block; font-family: var(--font-technical); font-size: clamp(32px, 3.8vw, 52px); font-weight: 500; letter-spacing: -.055em; line-height: 1.15; font-variant-numeric: tabular-nums; color: var(--ink); }
  .map-stat .label { margin-top: 14px; }
  .map-stat p { font-size: 14px; line-height: 1.5; color: var(--muted); margin: 8px 0 0; max-width: 25ch; }
  .foot { margin-top: 28px; }
  .proof { font-size: 12px; line-height: 1.5; }
  @media (max-width: 900px) {
    .origin-grid { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .origin-copy > p { max-width: 55ch; }
    .map-mat { max-width: 650px; width: 100%; }
  }
  @media (max-width: 600px) {
    .origin-map { padding: 56px 20px; }
    .origin-copy h2 { font-size: 36px; }
    .map-mat { padding: 12px; border-radius: 22px; }
    .map-card { padding: 18px 14px; border-radius: 12px; }
    .map-card h2 { font-size: 24px; }
    .map-results { grid-template-columns: 1fr; gap: 24px; margin-top: 32px; }
    .map-stat + .map-stat { border-top: 1px solid var(--chart-grid); padding-top: 24px; }
    .map-stat strong { font-size: 40px; }
    .map-stat p { max-width: 40ch; }
  }

  .map-mat { position: relative; isolation: isolate; overflow: clip; padding: 34px; background: #edf4df; border-color: #e1e8d6; }
  .liquid-field { position: absolute; inset: -30%; z-index: -1; pointer-events: none; overflow: hidden; }
  .liquid-field i { position: absolute; width: 85%; height: 85%; border-radius: 45%; background: radial-gradient(ellipse, #8cba4f 0%, #b3d47b 32%, #d4e7b3 55%, transparent 72%); animation: liquid-drift 17s ease-in-out infinite alternate; }
  .liquid-field i:nth-child(1) { left: -18%; top: -12%; }
  .liquid-field i:nth-child(2) { right: -15%; bottom: -18%; background: radial-gradient(ellipse, #7fab42 0%, #b4d580 35%, transparent 70%); animation-duration: 21s; animation-delay: -9s; }
  .liquid-field i:nth-child(3) { left: 18%; top: 16%; width: 65%; height: 65%; background: radial-gradient(ellipse, #f5f9ec 0%, #e3efcf 35%, transparent 70%); animation-duration: 13s; animation-delay: -5s; }
  .map-card { position: relative; background: #fff; }
  @keyframes liquid-drift { from { transform: translate3d(-8%, -6%, 0) rotate(-16deg) scale(.95); } to { transform: translate3d(15%, 12%, 0) rotate(22deg) scale(1.12); } }
  @media (max-width: 600px) { .map-mat { padding: 22px 16px; } }
  @media (prefers-reduced-motion: reduce) { .liquid-field i { animation: none; } }



  .corridor-rules { margin: 26px 0; font: 12px/1.6 var(--font-technical); }
  .corridor-rules > div { display: grid; grid-template-columns: 66px 1fr; gap: 14px; padding: 12px 0; border-top: 1px solid #d7dfe8; }
  .corridor-rules dt { color: #273846; font-weight: 500; }
  .corridor-rules dd { color: #596675; margin: 0; }
  .scenario-label { font: 11px/1.5 var(--font-technical); color: #596675; margin: -8px 0 8px; }

  .map-stat { border-left: 1px solid #d7dfe8; padding-left: 24px; }
  .map-stat:first-child { border-left: 0; padding-left: 0; }
  .backtest-link { display: inline-block; font: 12px/1.5 var(--font-technical); color: #4b657a; text-underline-offset: 4px; padding: 12px 0; }
  .backtest-link:focus-visible { outline: 2px solid #555; outline-offset: 3px; }
  .liquid-field { opacity: .65; }
  @media(max-width:600px) { .map-stat { border-left: 0; padding-left: 0; } }

  .origin-map { padding-block: 16px; scroll-margin-top: 72px; }
  .map-mat { padding: 16px; }
  .map-card { padding: 16px 20px; border-radius: 16px; }
  .position-widget { --panel: #f0f3f6; --surface: #fff; }
  .position-widget .position-pair { margin-block: 8px; }
  .position-widget .position-pair > span:not(.pair-arrow) { background: var(--panel); border-radius: 24px; padding: 6px 12px 6px 6px; gap: 8px; font-size: 20px; }
  .position-widget .position-pair img { width: 28px; height: 28px; }
  .position-widget .position-pair .pair-arrow img { width: 20px; height: 20px; }

  .position-pair { margin-top: 8px; gap: 16px; }
  .position-pair .pair-arrow img { width: 24px; height: 24px; }
  .map-note { font: 12px/1.45 inherit; margin-top: 10px; padding-top: 10px; }
  .map-results { margin-top: 18px; padding-top: 14px; gap: 24px; }
  .map-stat strong { font-size: 36px; line-height: 1; }
  .map-stat .label { margin-top: 8px; font-size: 11px; }
  .map-stat p { font-size: 12px; line-height: 1.4; margin-top: 4px; max-width: 38ch; }
  .backtest-link { padding: 4px 0; font-size: 11px; }
  .origin-copy h2 { font-size: clamp(36px, 3.5vw, 48px); }
  .corridor-rules { margin-block: 18px; }
  .micro { margin-top: 18px; }
  @media(max-width:900px) { .origin-map { padding-block: 40px; } }
</style>
