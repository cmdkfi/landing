---
import { meadowCopy, positionStage as copy } from '../../content/counter-measure';
import BorrowShow from './borrow-show/BorrowShow';
import { statusLabel } from '../../content/concept-landing';
import PriceProtection from './PriceProtection.astro';
import ControlRail from './ControlRail.astro';
---
<section class="ltv-stage" id="control" aria-label={meadowCopy.sceneLabel}>
  <div class="ltv-stage-sticky">
    <div class="ltv-stage-copy">
      <div role="tablist" aria-label={copy.tabLabel} aria-orientation="vertical">
        {copy.tabs.map((tab, index) => <div class="story-item">
          <button type="button" role="tab" id={`story-tab-${index}`} aria-controls={`story-panel-${index}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}><span class="story-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span>{tab.title}</span></button>
          <div class="story-description" hidden={index !== 0}><b>{tab.summary}</b><p>{tab.detail}</p></div>
        </div>)}
      </div>
    </div>
    <div class="ltv-stage-window" data-lenis-prevent>
      <div class="stage-window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="stage-availability">{statusLabel.live}</span><span>{copy.windowTitle}</span></div>
      <div id="story-panel-0" role="tabpanel" aria-labelledby="story-tab-0" class="story-panel" tabindex="0">
        <BorrowShow client:load />
      </div>
      <div id="story-panel-1" role="tabpanel" aria-labelledby="story-tab-1" class="story-panel" tabindex="0" hidden><PriceProtection /></div>
      <div id="story-panel-2" role="tabpanel" aria-labelledby="story-tab-2" class="story-panel" tabindex="0" hidden>
        <PriceProtection kind="venue" />
      </div>
    </div>
    <ControlRail side="agent" />
    <ControlRail side="owner" />
  </div>
</section>
<style>
  .ltv-stage { --map-line: #d6dce2; width:calc(var(--page-width) - 2 * var(--panel-inset)); max-width:none; margin:48px auto var(--section-space); padding-inline:0; }
  .ltv-stage-sticky { display: grid; grid-template-columns: minmax(210px,1fr) minmax(0,620px) minmax(210px,1fr); gap: 32px; align-items: center; }
  .ltv-stage-copy { grid-column: 1 / -1; width: 100%; margin-bottom: 16px; }
  [role="tablist"] { display: grid; grid-template-columns: repeat(3,1fr); gap: 28px; }
  .story-item { border-top: 1px solid #e1e3e6; }
  .story-item:has([aria-selected="true"]) { border-top-color: #b9c1c9; }
  .story-item button { width:100%; min-height:88px; text-align:left; border:0; background:transparent; padding:20px 0 18px; color:#526171; font:inherit; font-size:24px; font-weight:650; line-height:1.25; letter-spacing:-.025em; cursor:pointer; }
  .story-number { display:block; margin-bottom:16px; color:#637080; font-size:11px; font-weight:500; line-height:1.4; letter-spacing:.1em; }
  .story-item button[aria-selected="true"] { color:#263442; }
  .story-item button:hover { color:#17202b; }
  .story-description { min-height: 108px; max-width: 44ch; }
  .story-description b { display:block; font-size:16px; font-weight:500; line-height:1.6; margin-bottom:12px; color:#526171; }
  .story-description p { margin:0; font-size:16px; line-height:1.6; color:#637080; }
  .ltv-stage-window { position:relative; z-index:2; width:100%; height:740px; border:1px solid #e1e3e6; border-radius:22px; background:#fff; box-shadow:0 18px 48px #17202b12,0 3px 10px #17202b08; overflow:clip; }
  .stage-window-bar { position:relative; z-index:5; height:40px; display:flex; align-items:center; gap:16px; padding:0 18px; background:#f1f2f4; border-bottom:1px solid #e1e3e6; color:#65707a; font:10px/1 var(--font-technical); letter-spacing:.07em; }
  .stage-availability { flex-shrink:0; padding:3px 8px; border:1px solid #cce1d4; border-radius:999px; background:#edf5f0; color:#216c4c; font:12px/1.4 var(--font-sans,sans-serif); letter-spacing:normal; white-space:nowrap; }
  .window-dots { display:flex; gap:6px; }
  .window-dots i { width:8px; height:8px; border-radius:50%; background:#c3c7cd; }
  .story-panel { min-height:0; height:calc(100% - 40px); }
  [hidden] { display:none!important; }
  button:focus-visible,.story-panel:focus-visible { outline:2px solid #4b657a; outline-offset:4px; }
  .ltv-stage-window :global(.position-widget) { border:0; border-radius:0; box-shadow:none; padding-top:12px; }
  .ltv-stage-window :global(.position-label) { display:block; margin:0; padding:16px 22px 0; }
  @media (min-width:1101px) {
    .ltv-stage-copy { grid-column:1 / -1; grid-row:1; width:calc((100% - var(--grid-gap)) / 2.25); justify-self:start; }
    [role="tablist"] { display:block; }
    .story-description { min-height:0; padding-bottom:24px; }
    .ltv-stage-window { grid-column:1 / -1; grid-row:1; width:calc((100% - var(--grid-gap)) * 1.25 / 2.25); justify-self:end; }
    .ltv-stage-sticky > :global(.control-rail) { grid-row:2; }
    .ltv-stage-sticky > :global(.control-rail.agent) { grid-column:1 / 3; }
    .ltv-stage-sticky > :global(.control-rail.owner) { grid-column:3; }
    .is-motion { height:480svh; }
    .is-motion .ltv-stage-sticky { position:sticky; top:88px; height:calc(100svh - 112px); display:flex; justify-content:center; }
    .is-motion .ltv-stage-window { flex:none; }
    .is-motion .ltv-stage-copy { position:absolute; left:0; width:calc((100% - var(--grid-gap)) / 2.25); margin:0; }
    .is-motion .ltv-stage-sticky > :global(.control-rail) { position:absolute; width:calc((100% - (100% - var(--grid-gap)) * 1.25 / 2.25) / 2 - 32px); }
    .is-motion .ltv-stage-sticky > :global(.control-rail.agent) { left:0; }
    .is-motion .ltv-stage-sticky > :global(.control-rail.owner) { right:0; }
  }
  @media (min-width:1101px) and (max-height:850px) { .ltv-stage-window { height:650px; } .is-motion .ltv-stage-sticky { top:80px; height:calc(100svh - 96px); } }
  @media (max-width:1100px) {
    .ltv-stage-sticky { grid-template-columns:minmax(0,620px); justify-content:center; gap:28px; }
    .ltv-stage-copy { grid-column:1; }
    .ltv-stage-window { grid-row:2; height:780px; }
    .story-description { min-height:0; padding-bottom:20px; }
    [role="tablist"] { display:block; }
  }
  @media (max-width:800px) { .ltv-stage { width:calc(var(--page-width) - 32px); } }
  @media (max-width:600px) {
    .ltv-stage { padding-inline:0; margin-top:32px; }
    [role="tablist"] { grid-template-columns:1fr; gap:0; }
    .story-description { padding-bottom:20px; }
    .stage-window-bar { gap:10px; padding-inline:12px; }
    .ltv-stage-window { border-radius:20px; }
  }
</style>
<script>
  import { attachStoryTabs } from '../../scripts/story-tabs';
  import { attachLtvStage } from '../../scripts/ltv-stage';
  const disposeTabs = attachStoryTabs();
  const disposeStage = attachLtvStage();
  const dispose = () => { disposeTabs(); disposeStage(); };
  document.addEventListener('astro:before-swap', dispose, { once: true });
  if (import.meta.hot) import.meta.hot.dispose(dispose);
</script>
