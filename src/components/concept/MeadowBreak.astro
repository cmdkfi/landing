---
import { meadowCopy } from '../../content/counter-measure';
import PositionWidget from './PositionWidget.astro';
---
<section class="meadow-break" aria-label={meadowCopy.sceneLabel}>
  <PositionWidget />
</section>

<style>
  .meadow-break {
    display: flex;
    justify-content: center;
    max-width: 1320px;
    margin: 120px auto 0;
    padding: 0 24px 48px;
    background: #fff;
  }

  @media (max-width: 600px) {
    .meadow-break { margin-top: 72px; padding: 0 12px 32px; }
  }
</style>
