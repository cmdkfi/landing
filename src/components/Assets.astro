---
import { assets, visual, features, groupLabel } from '../content/landing.ts';
import FeatureList from './FeatureList.astro';
import StatusChip from './StatusChip.astro';
const summary = ['eth', 'btc', 'stocks', 'gold'].map((id) => features.find((f) => f.id === id)!);
---
<section id={assets.id} class="section">
  <div class="section-heading"><h2>{visual.assetsTitle}</h2><p class="muted">{visual.assetsIntro}</p></div>
  <ul class="panel asset-summary">{summary.map((f) => <li><span class="asset-symbol" aria-hidden="true">{f.id === 'eth' ? '◇' : f.id === 'btc' ? '₿' : f.id === 'gold' ? '◈' : '▤'}</span><strong>{f.title}</strong><StatusChip status={f.status} /></li>)}</ul>
  <p class="section-note">{assets.note}</p>
  <details class="disclosure"><summary>{visual.assetsDetails}</summary><div class="two-columns asset-groups">{assets.grids.map((g) => <div><h3>{groupLabel[g]}</h3><FeatureList group={g} /></div>)}</div></details>
</section>
