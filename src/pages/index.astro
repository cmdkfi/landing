---
// A Light: approved visual chapters, with the full feature inventory preserved in disclosures.
import Base from '../layouts/Base.astro';
import { meta, visual } from '../content/landing.ts';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import ForWhom from '../components/ForWhom.astro';
import PillarMarket from '../components/PillarMarket.astro';
import PillarVenue from '../components/PillarVenue.astro';
import Assets from '../components/Assets.astro';
import Control from '../components/Control.astro';
import Strategies from '../components/Strategies.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Proof from '../components/Proof.astro';
import StatusTable from '../components/StatusTable.astro';
import Limits from '../components/Limits.astro';
import AgentSection from '../components/AgentSection.astro';
import FinalAction from '../components/FinalAction.astro';
---
<Base title={meta.title} description={meta.description} page="index">
  <div class="wrap">
    <Hero />
    <section class="section responses"><h2>{visual.responses}</h2><div class="two-columns"><PillarMarket /><PillarVenue /></div><details class="disclosure context-details"><summary>{visual.problemDetails}</summary><div class="context-grid"><Problem /><ForWhom /></div></details></section>
    <Control /><HowItWorks /><Proof /><Assets /><Strategies /><StatusTable /><Limits /><AgentSection /><FinalAction />
  </div>
</Base>
