---
import '../styles/global.css';
import { hero, links, cta, testnetLine, walletBrowserCaption, meta, concept } from '../content/landing.ts';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="description" content={meta.description} />
    <title>{concept.title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="concept-page">
    <a class="concept-skip" href="#main">{concept.skip}</a>
    <header class="concept-header">
      <a class="concept-logo" href="/1" aria-label={concept.home}>
        <img src="/cmdk-mark.svg" alt={concept.logo} width="112" height="55" />
      </a>
      <nav class="concept-nav" aria-label={concept.nav}>
        <a href="#how">{concept.how}</a>
        <a href="#limits">{concept.control}</a>
        <a href="#proof">{concept.evidence}</a>
        <a href={links.agents}>{cta.askAgent}</a>
      </nav>
      <a class="concept-header-cta" href={links.testnet}>{cta.openTestnet} <span aria-hidden="true">↗</span></a>
    </header>

    <main id="main">
      <section class="concept-hero" aria-labelledby="concept-title">
        <div class="concept-copy">
          <p class="concept-eyebrow"><span class="concept-pulse" aria-hidden="true"></span> {concept.eyebrow}</p>
          <h1 id="concept-title">{concept.headingStart} <span>{concept.headingEnd}</span></h1>
          <p class="concept-lead">{concept.lead}</p>
          <div class="concept-actions">
            <a class="concept-button concept-button-primary" href={links.testnet}>{cta.openTestnet} <span aria-hidden="true">↗</span></a>
            <a class="concept-button concept-button-secondary" href={links.sandbox}>{cta.sandbox} <span aria-hidden="true">↗</span></a>
          </div>
          <p class="concept-sandbox-note">{hero.sandboxCaption}</p>
          <p class="concept-testnet">{testnetLine}</p>
          <p class="concept-wallet-note">{walletBrowserCaption}</p>
          <ul class="concept-proof" aria-label={concept.proofLabel}>
            <li>{concept.proof[0]}</li>
            <li>{concept.proof[1]}</li>
          </ul>
        </div>

        <div class="concept-mark-stage" aria-hidden="true">
          <span class="concept-moon"></span>
          <img src="/cmdk-mark.svg" width="448" height="220" alt="" />
        </div>
      </section>

      <div class="concept-bottom" id="how"><span>{concept.nextLabel}</span><p>{concept.next}</p><a href="/">{concept.fullLanding} <span aria-hidden="true">↗</span></a></div>
      <div class="concept-anchors" id="limits"><span>{concept.controlNote}</span><a id="proof" href={links.repo}>{concept.codeEvidence} ↗</a></div>
    </main>
  </body>
</html>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body.concept-page) { margin: 0; min-height: 100vh; background: radial-gradient(ellipse at 43% 35%, #1a2230 0%, transparent 48%), radial-gradient(ellipse at 82% 74%, #101827 0%, transparent 53%), #070b13; color: #f5f4f7; font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 16px; overflow-x: hidden; }
  :global(body.concept-page *) { box-sizing: border-box; }
  :global(body.concept-page)::before { content: ''; position: fixed; inset: 0; pointer-events: none; z-index: 0; opacity: .55; background-image: radial-gradient(1px 1px at 8% 18%, #d6e3f9 98%, transparent), radial-gradient(1px 1px at 24% 57%, #d6e3f9 98%, transparent), radial-gradient(1.5px 1.5px at 39% 12%, #e6edff 98%, transparent), radial-gradient(1px 1px at 55% 69%, #d6e3f9 98%, transparent), radial-gradient(1px 1px at 71% 32%, #d6e3f9 98%, transparent), radial-gradient(1.5px 1.5px at 89% 81%, #e6edff 98%, transparent); background-size: 290px 260px; }
  .concept-header, main { position: relative; z-index: 1; }
  .concept-skip { position: absolute; top: -100px; left: 16px; z-index: 20; padding: 10px; background: #fff; color: #090a10; }
  .concept-skip:focus { top: 12px; }
  .concept-header { width: min(1320px, calc(100% - 64px)); margin: 0 auto; padding-top: 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .concept-logo, .concept-nav, .concept-header-cta { min-height: 58px; border: 1px solid #30313a; border-radius: 999px; background: rgba(5,7,13,.62); }
  .concept-logo { width: 134px; padding: 7px 10px; display: flex; align-items: center; justify-content: center; flex: none; }
  .concept-logo img { width: 96px; height: auto; display: block; }
  .concept-nav { display: flex; align-items: center; justify-content: center; gap: clamp(18px, 2.5vw, 42px); padding: 0 32px; }
  .concept-header a { color: #f5f4f7; text-decoration: none; font-size: 14px; font-weight: 600; white-space: nowrap; }
  .concept-nav a { color: #d5d3dc; }
  .concept-header a:hover { color: #efae9e; }
  .concept-header-cta { display: flex; align-items: center; justify-content: center; gap: 16px; padding: 0 25px; border-color: #ac8cb9; }
  .concept-header-cta span { font-size: 20px; }
  .concept-hero { width: min(1320px, calc(100% - 64px)); min-height: 730px; margin: 0 auto; display: grid; grid-template-columns: minmax(430px, .88fr) minmax(0, 1.12fr); align-items: center; gap: clamp(44px, 5vw, 88px); padding: 62px 0 70px; }
  .concept-copy { position: relative; z-index: 2; max-width: 570px; }
  .concept-eyebrow { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 28px; padding: 8px 13px; border: 1px solid #363741; border-radius: 999px; color: #dddbe2; font-size: 12px; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; }
  .concept-pulse { width: 7px; height: 7px; border-radius: 50%; background: #9fe1bc; box-shadow: 0 0 0 4px #9fe1bc21; }
  h1 { margin: 0; font-size: clamp(55px, 5.1vw, 80px); line-height: 1.01; letter-spacing: -.065em; font-weight: 750; }
  h1 span { color: #f2a394; }
  .concept-lead { max-width: 480px; margin: 28px 0 0; color: #b7b5c2; font-size: clamp(17px, 1.35vw, 20px); line-height: 1.55; letter-spacing: -.02em; }
  .concept-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .concept-button { min-height: 54px; padding: 0 21px; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; gap: 13px; text-decoration: none; font-size: 14px; font-weight: 700; transition: transform 150ms cubic-bezier(.23,1,.32,1), border-color 150ms ease, background-color 150ms ease; }
  .concept-button:hover { transform: translateY(-2px); }
  .concept-button:active { transform: scale(.97); }
  .concept-button-primary { background: linear-gradient(105deg, #f7a477, #c491dc 70%, #91aaf4); color: #17121e; border: 1px solid transparent; }
  .concept-button-secondary { color: #eeedf2; border: 1px solid #52515d; background: #1a1b25; }
  .concept-button-secondary:hover { border-color: #bc9fcb; }
  .concept-sandbox-note { margin: 9px 0 0 2px; color: #aaa7b7; font-size: 13px; }
  .concept-testnet { margin: 19px 0 0; color: #8d8d9c; font-size: 12px; line-height: 1.5; }
  .concept-wallet-note { display: none; margin: 8px 0 0; color: #aaa7b7; font-size: 12px; line-height: 1.5; }
  .concept-proof { display: flex; flex-wrap: wrap; gap: 17px 24px; padding: 24px 0 0; margin: 22px 0 0; border-top: 1px solid #2b2c37; list-style: none; color: #cac8d4; font-size: 13px; }
  .concept-proof li::before { content: '✓'; color: #bda5d5; margin-right: 8px; }
  .concept-mark-stage { min-height: 575px; position: relative; display: grid; place-items: center; isolation: isolate; }
  .concept-mark-stage::before { content: ''; position: absolute; width: 80%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, #8591b51a 0%, #8591b508 42%, transparent 68%); filter: blur(28px); z-index: -1; }
  .concept-mark-stage img { width: min(86%, 520px); height: auto; display: block; opacity: .96; filter: drop-shadow(0 24px 30px #0008); }
  .concept-moon { position: absolute; top: 10%; left: 19%; width: 20px; height: 20px; border-radius: 50%; box-shadow: 4px 2px 0 0 #c7cedc; transform: rotate(-25deg); opacity: .8; }
  .concept-bottom { width: min(1320px, calc(100% - 64px)); margin: 0 auto; padding: 25px 0 60px; border-top: 1px solid #30303a; display: flex; align-items: baseline; justify-content: space-between; gap: 22px; color: #a6a4b2; font-size: 13px; }
  .concept-bottom p { max-width: 500px; margin: 0; color: #f1f0f4; font-size: 17px; }
  .concept-bottom a, .concept-anchors a { color: #c9b9de; text-decoration: none; white-space: nowrap; }
  .concept-bottom a:hover, .concept-anchors a:hover { text-decoration: underline; }
  .concept-anchors { width: min(1320px, calc(100% - 64px)); margin: 0 auto; padding: 0 0 36px; display: flex; gap: 20px; justify-content: space-between; color: #898796; font-size: 12px; }
  :global(body.concept-page a:focus-visible) { outline: 2px solid #f3b49b; outline-offset: 4px; }
  @media (max-width: 950px) { .concept-nav { display: none; } .concept-hero { grid-template-columns: 1fr; padding-top: 70px; gap: 35px; } .concept-copy { max-width: 690px; } .concept-mark-stage { width: min(100%, 690px); margin: auto; } }
  @media (max-width: 959px) { .concept-wallet-note { display: block; } }
  @media (max-width: 600px) { .concept-header, .concept-hero, .concept-bottom, .concept-anchors { width: calc(100% - 36px); } .concept-header { padding-top: 14px; } .concept-logo { min-height: 48px; width: 112px; } .concept-logo img { width: 82px; } .concept-header-cta { min-height: 48px; padding: 0 15px; font-size: 12px !important; } .concept-hero { padding-top: 70px; padding-bottom: 42px; } h1 { font-size: clamp(49px, 13vw, 70px); } .concept-lead { margin-top: 23px; } .concept-button { width: 100%; } .concept-sandbox-note { margin-left: 0; } .concept-proof { display: grid; gap: 9px; } .concept-mark-stage { min-height: 320px; } .concept-mark-stage img { width: min(84%, 360px); } .concept-moon { top: 5%; } .concept-bottom { display: block; } .concept-bottom p { margin: 16px 0; } }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } .concept-button { transition: none; } .concept-button:hover { transform: none; } }
</style>
